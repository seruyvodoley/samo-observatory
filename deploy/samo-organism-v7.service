[Unit]
Description=SAMO v7 experimental morphology ecology
Requires=srv-samo.mount
After=srv-samo.mount
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=simple
User=samo-organism
Group=samo-data
Slice=samo.slice
WorkingDirectory=/srv/samo/releases/core-v7/code
Environment=PYTHONDONTWRITEBYTECODE=1 TMPDIR=/srv/samo/state/tmp PYTHONPATH=/srv/samo/releases/core-v7/code SAMO_ENV=vps
ExecStart=/usr/bin/python3 -m morphology.runtime_v7 run --db /srv/samo/state/ecology-v7.sqlite --seed 2026110207 --arm v7_neutral --pause 1 --export /srv/samo/site/data/ecosystem.json
Restart=on-failure
RestartSec=30s
TimeoutStartSec=120s
TimeoutStopSec=15s
KillMode=control-group
CPUQuota=40%
CPUQuotaPeriodSec=100ms
MemoryMax=512000000
MemorySwapMax=0
TasksMax=32
LimitCORE=0
LimitNOFILE=64
UMask=0027
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateNetwork=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
SystemCallFilter=~@mount @raw-io @reboot @swap
ReadWritePaths=/srv/samo/state /srv/samo/site/data
InaccessiblePaths=-/etc/wireguard -/etc/xray -/etc/tunneldeck -/var/lib/docker -/run/docker.sock -/run/systemd/private
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
